# Locked: comes from sandrogekeler/AllesSandro and is re-applied by every
# template update. Change it there, not here; a local edit surfaces as a merge
# conflict on the next update (AllesSandro docs/updating.md).
#
# The language matrix is rendered from this repo's `languages` answer in
# .copier-answers.yml. GitHub Actions workflows are always scanned.
#
# Rendered only when the `public` answer is true: on a private repository code
# scanning needs GitHub Advanced Security, so the analysis would run and its
# upload be refused. Making the repo public is `copier update --data public=true`.
name: CodeQL

on:
  push:
    branches: [{{ default_branch }}]
  pull_request:
    branches: [{{ default_branch }}]
  schedule:
    - cron: '36 14 * * 0'

permissions:
  contents: read

jobs:
  analyze:
    name: Analyze (${{ '{{' }} matrix.language {{ '}}' }})
    runs-on: ubuntu-latest
    permissions:
      security-events: write
      packages: read
      actions: read
      contents: read

    strategy:
      fail-fast: false
      matrix:
        include:
          - language: actions
            build-mode: none
{%- if 'go' in languages %}
          - language: go
            build-mode: autobuild
{%- endif %}
{%- if 'typescript' in languages %}
          - language: javascript-typescript
            build-mode: none
{%- endif %}
{%- if 'kotlin' in languages %}
          # Build mode none leaves Kotlin files out of the database entirely;
          # Kotlin is only analysed by a build.
          - language: java-kotlin
            build-mode: autobuild
{%- elif 'java' in languages %}
          # Without a build: no Gradle setup on the runner, and Java only
          # (Kotlin needs a build).
          - language: java-kotlin
            build-mode: none
{%- endif %}
          # The vendored .claude/ runner is Python, so Python is always scanned.
          - language: python
            build-mode: none

    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Initialize CodeQL
        uses: github/codeql-action/init@2892aa5e19bbd11bc0cff5427e3b750a04d9e3c2 # v4.38.2
        with:
          languages: ${{ '{{' }} matrix.language {{ '}}' }}
          build-mode: ${{ '{{' }} matrix.build-mode {{ '}}' }}

      - name: Perform CodeQL Analysis
        uses: github/codeql-action/analyze@2892aa5e19bbd11bc0cff5427e3b750a04d9e3c2 # v4.38.2
        with:
          category: "/language:${{ '{{' }} matrix.language {{ '}}' }}"
